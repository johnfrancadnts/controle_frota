rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sistema interno de controle de frota.
    // O acesso é intencionalmente simples, sem Firebase Authentication.
    match /frota/{collectionName}/{documentName} {
      allow read, write: if true;
    }
    match /frota/{collectionName}/items/{documentName} {
      allow read, write: if true;
    }
  }
}
